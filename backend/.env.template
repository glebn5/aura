# Настройки подключения к базе данных
# По умолчанию для Docker-окружения используется Postgres.
# Для локального тестирования вне докера можно переключить на SQLite: sqlite+aiosqlite:///./local_db.sqlite
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/auratracker

# API-ключ Google Gemini (Получить бесплатно на https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Настройки JWT токенов
JWT_SECRET=some_random_secure_long_string_here_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Google Auth Client ID (для интеграции с Android)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Флаг обхода авторизации (True = разрешает слать пустой заголовок Bearer Token для разработки)
# ВАЖНО: Выставить в False в продакшене!
BYPASS_AUTH=True
