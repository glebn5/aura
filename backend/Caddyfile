# Конфигурация веб-сервера Caddy для AuraTracker

# По умолчанию принимаем входящие HTTP запросы по IP-адресу сервера (порт 80)
:80 {
    reverse_proxy web:8000
}

# ==========================================
# Как настроить HTTPS (безопасное шифрование):
# ==========================================
# 1. Привяжите домен (например, api.auratracker.ru) к IP сервера: 45.194.66.113
# 2. Закомментируйте блок ":80" выше, поставив символ "#" перед каждой строкой.
# 3. Раскомментируйте строки ниже (уберите "#") и впишите ваш домен.
# 4. Выполните команду "docker compose restart caddy".

# api.auratracker.ru {
#     reverse_proxy web:8000
# }
